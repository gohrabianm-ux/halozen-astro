---
const { title, body, icon } = Astro.props;
---
<div class="p-6 rounded-2xl border shadow-sm hover:shadow-md transition">
  <div class="h-10 w-10 mb-4 rounded-full bg-gradient-to-r from-brand to-brand-light flex items-center justify-center text-white font-bold">{icon}</div>
  <h3 class="font-semibold text-lg mb-2">{title}</h3>
  <p class="text-gray-600 leading-relaxed">{body}</p>
</div>
