---
import Base from "@/layouts/Base.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import FeatureCard from "@/components/FeatureCard.astro";
---
<Base title="Halozen — Smart Cooling for Migraine Relief" description="Drug-free, fast-acting migraine relief using targeted cooling.">
  <Header />

  <!-- Hero (badge removed, prototype box removed) -->
  <section class="max-w-6xl mx-auto px-6 pt-20 pb-16 text-center">
    <h1 class="text-5xl md:text-6xl font-extrabold tracking-tight mb-4">
      Calm the storm. <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand to-brand-light">Fast.</span>
    </h1>
    <p class="text-xl text-gray-600 max-w-2xl mx-auto">
      Halozen delivers targeted cooling to ease migraine pain — drug-free, portable, and designed for comfort.
    </p>
    <div class="mt-8 flex items-center justify-center gap-3">
      <a href="#register" class="px-6 py-3 rounded-xl bg-brand text-white font-medium hover:bg-brand-dark">Register interest</a>
      <a href="#how" class="px-6 py-3 rounded-xl border font-medium hover:bg-gray-50">How it works</a>
    </div>
  </section>

  <!-- How it works -->
  <section id="how" class="max-w-6xl mx-auto px-6 py-16">
    <h2 class="text-3xl font-bold mb-8">How Halozen works</h2>
    <div class="grid md:grid-cols-3 gap-6">
      <FeatureCard icon="1" title="Targeted cooling" body="A precision cooling module draws heat away from key nerve regions for rapid soothing." />
      <FeatureCard icon="2" title="Adaptive control" body="Smart temperature regulation keeps cooling within the optimal comfort range for migraine relief." />
      <FeatureCard icon="3" title="Portable & silent" body="Whisper-quiet operation — use anytime, anywhere without medications." />
    </div>
  </section>

  <!-- Science -->
  <section id="science" class="max-w-6xl mx-auto px-6 py-16">
    <h2 class="text-3xl font-bold mb-8">Backed by science</h2>
    <div class="grid md:grid-cols-3 gap-6">
      <FeatureCard icon="✓" title="Thermal modulation" body="Cooling the trigeminal region may reduce nociceptive signaling linked to migraine." />
      <FeatureCard icon="✓" title="Drug-free approach" body="Non-pharmacological relief pathway to complement or reduce medication use." />
      <FeatureCard icon="✓" title="User-centered design" body="Designed for comfort, safety, and everyday reliability." />
    </div>
  </section>

  <!-- Register interest (replaces Join Waitlist) -->
  <section id="register" class="max-w-2xl mx-auto px-6 py-16 text-center">
    <div class="rounded-3xl border p-6 shadow-sm">
      <h2 class="text-3xl font-bold mb-2">Register your interest</h2>
      <p class="text-gray-600 mb-6">Sign up for product updates and early access opportunities. We’ll only email when we have real news.</p>
      <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST" class="flex flex-col md:flex-row gap-3 justify-center">
        <input type="email" name="email" placeholder="you@example.com" required class="flex-1 rounded-xl border px-4 py-3" />
        <button type="submit" class="px-6 py-3 rounded-xl bg-brand text-white font-medium hover:bg-brand-dark">Register interest</button>
      </form>
      <p class="text-xs text-gray-500 mt-3">By registering, you agree to our <a href="/privacy" class="underline">privacy policy</a>.</p>
    </div>
  </section>

  <Footer />
</Base>
