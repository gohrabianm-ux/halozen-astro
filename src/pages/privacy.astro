---
import Base from "@/layouts/Base.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---
<Base title="Halozen — Privacy Policy" description="Privacy policy for Halozen waitlist and website.">
  <Header />
  <main class="max-w-3xl mx-auto px-6 py-16 prose prose-slate">
    <h1>Privacy Policy</h1>
    <p><em>Last updated: {new Date().toISOString().slice(0, 10)}</em></p>
    <p>We collect your email address when you join the waitlist. We use it only to send updates about Halozen. You can unsubscribe anytime by replying “unsubscribe”.</p>
    <h2>Data we collect</h2>
    <ul>
      <li>Email address submitted through our form.</li>
      <li>Basic analytics (page views, referrers) if enabled by the hosting provider.</li>
    </ul>
    <h2>How we use your data</h2>
    <ul>
      <li>To notify you about product progress, early access, and launches.</li>
      <li>To improve the website experience.</li>
    </ul>
    <h2>Your rights</h2>
    <p>Contact us at <a href="mailto:hello@halozen.co">hello@halozen.co</a> to request access, correction, or deletion of your data.</p>
  </main>
  <Footer />
</Base>
